# ==========================================
# 1. Backend Render (FastAPI)
# ==========================================
OPENAI_API_KEY="" 
OPENAI_VISION_MODEL="gpt-4o"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
MONGO_URI=""
MONGO_DB_NAME="CuongProAI"
AGENT_TOKEN="your-super-secret-token-here"
FRONTEND_ORIGIN="https://my-frontend.vercel.app"

# VNPay Credentials (Sandbox)
VNPAY_TMN_CODE=""
VNPAY_HASH_SECRET=""
VNPAY_RETURN_URL="https://your-backend-app.onrender.com/payment/vnpay_return"

# ==========================================
# 2. Desktop Agent (Local)
# ==========================================
BACKEND_WS_URL="wss://your-backend-app.onrender.com/automation/ws"
AGENT_TOKEN="your-super-secret-token-here"

# ==========================================
# 3. Frontend (Vercel / Local)
# ==========================================
# NOTE: For Frontend, you configure these inside static/config.js
# Local example:
# API_URL="http://localhost:8000"
# WS_URL="ws://localhost:8000/automation/ws"
#
# Production (Vercel) example:
# API_URL="https://your-backend-app.onrender.com"
# WS_URL="wss://your-backend-app.onrender.com/automation/ws"
